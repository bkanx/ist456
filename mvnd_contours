# Multivariate Normal Density and Contours

x.points <- seq(-3,4,length.out=100)  # 100 x-values from -3 to 4
y.points <- x.points                  # same 100 y values

z <- matrix(0,nrow=100,ncol=100)      # builds a grid over yc in [-3,4]
mu <- c(1,1)                          # mean at (1,1)
sigma <- matrix(c(2,1,1,1),nrow=2)    # cov(X)

# Check: Determinant — is it nonzero?

det(sigma)   # if det > 0 invertible and the 1/det(sigma) factor is finite
             # If det(sigma) == 0 → not invertible → no (sigma)^  -sooo density undefined.

# Check:Eigenvalues — are they all > 0?
eigen(sigma, symmetric = TRUE)$values      # Both >0. So matris is positive definite
                                           # Any eigenvalue <=0 means the matrix is not positive definite- the quadratic term 
                                           # can go negative- which leads (exp(+something)) - invalid density


for (i in 1:100) {
for (j in 1:100) {
# Evaluates the density at every grid point with dmvnorm (from the mvtnorm package) and
# stores the result in z[i,j].  
z[i,j] <- dmvnorm(c(x.points[i],y.points[j]), mean=mu, sigma=sigma)
}
}

contour(x.points,y.points,z)
# We plot constant z slices (contours) on a 2-D format.
# These contours can be constructed from the eigenvalues and eigenvectors of the covariance matrix
# The direction of the ellipse axes are in the direction of the eigenvalues
# The length of the ellipse axes are proportional to the constant times the eigenvector
# The lines of the contour plots denote places of equal probability mass for the MVN distribution

# Results:
# Concentric ellipses centered at (1,1)
# Tilted along the +45 degree line-(positive correlation ≈ 0.707)
# more spread in x (variance 2) than y (variance 1)- Slightly wider horizontally
# Inner contours are enclose the mean, outer contours are larger



